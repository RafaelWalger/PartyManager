# =====================================================================
# Copie este arquivo para ".env" (na raiz do projeto) e preencha.
# O .env NÃO vai para o GitHub (está no .gitignore).
# No Vercel o .env não é usado: lá a integração com o Supabase cria sozinha
# as variáveis POSTGRES_URL e POSTGRES_PASSWORD, que o site também entende.
# =====================================================================

# Conexão com o PostgreSQL do Supabase.
# No Supabase: botão "Connect" no topo do projeto > "Transaction pooler" (porta 6543).
# Troque [SENHA] pela senha do banco que você criou junto com o projeto.
DATABASE_URL=postgresql://postgres.SEU_PROJETO:[SENHA]@aws-0-sa-east-1.pooler.supabase.com:6543/postgres?sslmode=require

# Chave secreta que assina o cookie de login. Gere uma com:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=troque-por-uma-chave-aleatoria-grande

# Porta do site no seu PC (abre em http://localhost:8080)
PORTA=8080
